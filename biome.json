{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!dist",
			"!coverage",
			"!docs/examples",
			"!CHANGELOG.md",
			"!pnpm-lock.yaml",
			"!ARCHITECTURE.md",
			"!docs/wiki/Configuration.md"
		]
	},
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git",
		"defaultBranch": "main"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"lineWidth": 120,
		"indentStyle": "tab",
		"lineEnding": "lf"
	},
	"linter": {
		"includes": ["**", "!**/*.d.ts*"],
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "error"
			},
			"style": {
				"useAtIndex": "error",
				"useConsistentTypeDefinitions": { "level": "error", "options": { "style": "interface" } }
			}
		}
	}
}
