{
	"name": "github-star-tracker",
	"version": "1.26.4",
	"private": true,
	"description": "GitHub Action to automatically track star count changes across repositories with visual charts, email notifications, and historical reports",
	"keywords": [
		"github",
		"github-action",
		"github-actions",
		"github-stars",
		"star-tracker",
		"star-history",
		"tracker",
		"monitoring",
		"analytics",
		"metrics",
		"statistics",
		"automation",
		"reporting",
		"notifications",
		"badges",
		"charts",
		"repository",
		"devops",
		"ci-cd",
		"typescript"
	],
	"author": "Ferran Buireu <fbuireu@gmail.com>",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fbuireu/github-star-tracker.git"
	},
	"homepage": "https://github.com/fbuireu/github-star-tracker#readme",
	"bugs": {
		"url": "https://github.com/fbuireu/github-star-tracker/issues"
	},
	"engines": {
		"node": "26.2.0"
	},
	"packageManager": "pnpm@12.0.0",
	"scripts": {
		"prepare": "husky",
		"build": "tsx esbuild.config.ts",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format .",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched .",
		"typecheck": "tsc --noEmit",
		"test:ut": "vitest run --logHeapUsage",
		"test:ut:watch": "vitest",
		"test:ut:coverage": "pnpm test:ut --coverage",
		"test:ut:changed": "pnpm test:ut --changed origin/main",
		"test:docs": "pnpm test:ut docs/docs-consistency.test.ts",
		"verify": "pnpm format:check && pnpm typecheck && pnpm test:ut:coverage && pnpm build"
	},
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/github": "9.1.1",
		"@octokit/plugin-retry": "8.1.1",
		"js-yaml": "5.4.1",
		"nodemailer": "9.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@commitlint/format": "21.2.2",
		"@commitlint/types": "21.2.0",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "12.0.9",
		"@semantic-release/npm": "13.1.5",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.4.0",
		"@types/nodemailer": "8.0.1",
		"@vitest/coverage-v8": "4.1.11",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"semantic-release": "25.0.9",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
